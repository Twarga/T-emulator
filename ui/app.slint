import { Tokens } from "tokens.slint";
import { Picker, ConsoleEntry } from "pages/picker.slint";
import { Xmb, GameModel } from "skins/xmb.slint";
import { BootSplash } from "components/bootsplash.slint";

export component App inherits Window {
    title: "T-Emulator";
    background: Tokens.bg;
    preferred-width: 1280px; preferred-height: 800px;

    // modes: 0 picker, 1 bootsplash, 2 xmb
    in-out property <int> mode: 0;
    in-out property <string> active-console: "PSP";

    in property <[ConsoleEntry]> consoles: [];
    in property <[GameModel]> games: [];
    callback power_on(string);
    callback play_game(string);
    callback exit_console();

    in-out property <float> wave-t: 0;
    Timer {
        interval: 16ms; running: true;
        triggered => { wave-t += 0.016; }
    }

    if root.mode == 0: Picker {
        consoles: root.consoles;
        power_on(idx) => {
            root.active-console = root.consoles[idx].title;
            root.mode = 1;
            root.power_on(root.consoles[idx].title);
        }
    }

    if root.mode == 1: BootSplash {
        console-name: root.active-console;
        finished => { root.mode = 2; }
    }

    if root.mode == 2: Xmb {
        games: root.games;
        wave-t: root.wave-t;
        play_game(p) => { root.play_game(p); }
        exit_console() => { root.mode = 0; root.exit_console(); }
    }
}
