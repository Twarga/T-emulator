import { Tokens } from "../tokens.slint";

// Coldboot-style splash: fades in name + accent bar, then signals done.
export component BootSplash inherits Rectangle {
    in property <string> console-name: "PSP";
    in property <color> accent: Tokens.accent-xmb;
    callback finished();

    background: black;
    opacity: 1.0;

    property <float> phase: 0;
    Timer {
        interval: 16ms; running: true;
        triggered => {
            phase += 0.016;
            if (phase > 1.4) { root.finished(); self.running = false; }
        }
    }

    Text {
        text: root.console-name;
        color: white; font-size: 42px; font-weight: 200; letter-spacing: 8px;
        opacity: Math.min(phase / 0.6, 1.0) * (phase > 1.1 ? Math.max(0, (1.4 - phase) / 0.3) : 1.0);
    }

    Rectangle {
        width: 120px; height: 2px; y: parent.height / 2 + 40px;
        x: (parent.width - self.width) / 2;
        background: root.accent;
        opacity: Math.min(phase / 0.8, 1.0);
    }

    // skip on any input
    TouchArea { clicked => { root.finished(); } }
    Keys { on-key-pressed: (ev) => { root.finished(); accept; } }
}
