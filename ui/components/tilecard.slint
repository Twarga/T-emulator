import { Tokens } from "../tokens.slint";

export component TileCard inherits Rectangle {
    in property <string> title;
    in property <string> subtitle: "";
    in property <string> glyph: "🎮";
    in property <bool> enabled: true;
    in property <bool> focused: false;
    in property <color> accent: Tokens.accent;
    callback activated();

    width: 300px; height: 190px;
    border-radius: 16px;
    background: focused
        ? accent.with-alpha(0.14)
        : Tokens.surface;
    border-width: focused ? 2px : 1px;
    border-color: focused ? accent : Tokens.border;
    opacity: enabled ? 1.0 : 0.40;

    animate border-color { duration: 160ms; }
    animate background { duration: 200ms; }

    // glow under focused card
    Rectangle {
        y: parent.height - 8px; height: 3px; width: 60%;
        x: (parent.width - self.width) / 2;
        border-radius: 2px;
        background: root.accent;
        opacity: root.focused ? 0.9 : 0.0;
        animate opacity { duration: 200ms; }
    }

    VerticalLayout {
        alignment: center; spacing: 10px; padding: 24px;
        Text {
            text: root.glyph; font-size: 46px;
            horizontal-alignment: center;
            opacity: root.enabled ? 1.0 : 0.5;
        }
        Text {
            text: root.title; color: Tokens.text;
            font-size: 24px; font-weight: 700;
            horizontal-alignment: center;
        }
        if root.subtitle != "": Text {
            text: root.subtitle; color: Tokens.text-dim;
            font-size: 13px; horizontal-alignment: center;
        }
    }

    TouchArea {
        enabled: root.enabled;
        clicked => { root.activated(); }
    }
}
