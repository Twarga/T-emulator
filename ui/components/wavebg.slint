// WaveBg — XMB silk-ribbon approximation.
// Broad filled bands with soft gradient falloff, drifting; NOT thin lines.
import { Tokens } from "../tokens.slint";

export component WaveBg inherits Rectangle {
    in property <color> accent: Tokens.accent-xmb;
    in property <float> t: 0;

    // base vertical gradient — deep blue-ish, matches PSP XMB feel
    background: @linear-gradient(180deg, #0a0a16 0%, #0d1230 45%, #101a3f 100%);

    // Ribbon A — the big main sweep, upper half
    Path {
        viewbox-width: 100; viewbox-height: 100;
        fill: accent.with-alpha(0.16);
        MoveTo { x: -10; y: 18 + 4 * Math.sin((t * 22) * 1deg); }
        CubicTo { control-1-x: 25; control-1-y: 10 + 6 * Math.sin((t * 22 + 40) * 1deg);
                  control-2-x: 55; control-2-y: 30 + 6 * Math.sin((t * 22 + 80) * 1deg);
                  x: 110; y: 14 + 4 * Math.sin((t * 22 + 120) * 1deg); }
        LineTo { x: 110; y: 34 + 4 * Math.sin((t * 22 + 120) * 1deg); }
        CubicTo { control-1-x: 55; control-1-y: 50 + 6 * Math.sin((t * 22 + 80) * 1deg);
                  control-2-x: 25; control-2-y: 28 + 6 * Math.sin((t * 22 + 40) * 1deg);
                  x: -10; y: 38 + 4 * Math.sin((t * 22) * 1deg); }
        Close {}
    }

    // Ribbon B — lower counter-ribbon
    Path {
        viewbox-width: 100; viewbox-height: 100;
        fill: accent.brighter(20%).with-alpha(0.10);
        MoveTo { x: -10; y: 62 + 5 * Math.sin((t * 18 + 200) * 1deg); }
        CubicTo { control-1-x: 30; control-1-y: 52 + 7 * Math.sin((t * 18 + 240) * 1deg);
                  control-2-x: 60; control-2-y: 74 + 7 * Math.sin((t * 18 + 290) * 1deg);
                  x: 110; y: 58 + 5 * Math.sin((t * 18 + 330) * 1deg); }
        LineTo { x: 110; y: 80 + 5 * Math.sin((t * 18 + 330) * 1deg); }
        CubicTo { control-1-x: 60; control-1-y: 90 + 7 * Math.sin((t * 18 + 290) * 1deg);
                  control-2-x: 30; control-2-y: 68 + 7 * Math.sin((t * 18 + 240) * 1deg);
                  x: -10; y: 82 + 5 * Math.sin((t * 18 + 200) * 1deg); }
        Close {}
    }

    // Ribbon C — thin accent highlight cutting across
    Path {
        viewbox-width: 100; viewbox-height: 100;
        fill: accent.brighter(45%).with-alpha(0.20);
        MoveTo { x: -10; y: 44 + 3 * Math.sin((t * 30 + 80) * 1deg); }
        CubicTo { control-1-x: 35; control-1-y: 36 + 5 * Math.sin((t * 30 + 130) * 1deg);
                  control-2-x: 65; control-2-y: 52 + 5 * Math.sin((t * 30 + 180) * 1deg);
                  x: 110; y: 40 + 3 * Math.sin((t * 30 + 230) * 1deg); }
        LineTo { x: 110; y: 44 + 3 * Math.sin((t * 30 + 230) * 1deg); }
        CubicTo { control-1-x: 65; control-1-y: 56 + 5 * Math.sin((t * 30 + 180) * 1deg);
                  control-2-x: 35; control-2-y: 40 + 5 * Math.sin((t * 30 + 130) * 1deg);
                  x: -10; y: 48 + 3 * Math.sin((t * 30 + 80) * 1deg); }
        Close {}
    }

    // soft top vignette to seat the category bar
    Rectangle {
        height: 180px; width: 100%;
        background: @linear-gradient(180deg, black 0%, transparent 100%);
        opacity: 0.35;
    }
}
