export global Icons {
    pure public function by-name(k: string) -> image {
        if (k == "gamepad") { return @image-url("../assets/icons/gamepad.svg"); }
        if (k == "gear") { return @image-url("../assets/icons/gear.svg"); }
        if (k == "sliders") { return @image-url("../assets/icons/sliders.svg"); }
        if (k == "folder") { return @image-url("../assets/icons/folder.svg"); }
        if (k == "refresh") { return @image-url("../assets/icons/refresh.svg"); }
        if (k == "power") { return @image-url("../assets/icons/power.svg"); }
        if (k == "info") { return @image-url("../assets/icons/info.svg"); }
        if (k == "download") { return @image-url("../assets/icons/download.svg"); }
        if (k == "music") { return @image-url("../assets/icons/music.svg"); }
        if (k == "lock") { return @image-url("../assets/icons/lock.svg"); }
        if (k == "chip") { return @image-url("../assets/icons/chip.svg"); }
        if (k == "monitor") { return @image-url("../assets/icons/monitor.svg"); }
        if (k == "volume") { return @image-url("../assets/icons/volume.svg"); }
        if (k == "gauge") { return @image-url("../assets/icons/gauge.svg"); }
        if (k == "expand") { return @image-url("../assets/icons/expand.svg"); }
        if (k == "photo") { return @image-url("../assets/icons/photo.svg"); }
        if (k == "check") { return @image-url("../assets/icons/check.svg"); }
        return @image-url("../assets/icons/disc.svg");
    }

    pure public function device(k: string) -> image {
        if (k == "ps3") { return @image-url("../assets/consoles/ps3.png"); }
        if (k == "gc") { return @image-url("../assets/consoles/gc.png"); }
        if (k == "ps2") { return @image-url("../assets/consoles/ps2.png"); }
        return @image-url("../assets/consoles/psp.png");
    }
}
