import { Pal } from "tokens.slint";
import { ConsoleInfo } from "types.slint";
import { Icons } from "icons.slint";
import { Hint } from "widgets.slint";

export component Launcher inherits Rectangle {
    in property <[ConsoleInfo]> consoles;
    in property <int> idx;
    in property <string> clock;
    in property <string> date;
    in property <length> u: 1px;

    // soft pool of light behind the focused device
    Rectangle {
        width: 1000 * root.u;
        height: 700 * root.u;
        x: (root.width - self.width) / 2;
        y: root.height * 0.38 - self.height / 2;
        background: @radial-gradient(circle, #ffffff2a 0%, #ffffff00 68%);
    }

    // top bar
    Text {
        x: 56 * root.u;
        y: 40 * root.u;
        text: "T-EMULATOR";
        font-size: 20 * root.u;
        font-weight: 600;
        letter-spacing: 7 * root.u;
        color: Pal.text;
    }
    Text {
        x: root.width - 356 * root.u;
        y: 30 * root.u;
        width: 300 * root.u;
        text: root.clock;
        font-size: 34 * root.u;
        font-weight: 300;
        horizontal-alignment: right;
        color: Pal.text;
    }
    Text {
        x: root.width - 356 * root.u;
        y: 72 * root.u;
        width: 300 * root.u;
        text: root.date;
        font-size: 16 * root.u;
        horizontal-alignment: right;
        color: Pal.text-dim;
    }

    // device carousel
    for c[i] in root.consoles: Image {
        property <int> d: i - root.idx;
        property <bool> foc: d == 0;
        source: Icons.device(c.kind);
        colorize: Pal.text;
        image-fit: contain;
        width: (foc ? 400 : 200) * root.u;
        height: (foc ? 270 : 135) * root.u;
        x: root.width / 2 + d * 360 * root.u - self.width / 2;
        y: root.height * 0.37 - self.height / 2;
        opacity: foc ? 1 : (Math.abs(d) == 1 ? 0.34 : 0.12);
        animate x, y, width, height, opacity { duration: 420ms; easing: ease-out; }
    }

    // identity
    Text {
        y: root.height * 0.585;
        width: root.width;
        text: root.consoles[root.idx].name;
        font-size: 76 * root.u;
        font-weight: 300;
        letter-spacing: 8 * root.u;
        horizontal-alignment: center;
        color: Pal.text;
    }
    Text {
        y: root.height * 0.585 + 96 * root.u;
        width: root.width;
        text: root.consoles[root.idx].full-name;
        font-size: 21 * root.u;
        horizontal-alignment: center;
        color: Pal.text-dim;
    }
    HorizontalLayout {
        y: root.height * 0.585 + 142 * root.u;
        height: 38 * root.u;
        alignment: center;
        Rectangle {
            height: parent.height;
            border-radius: self.height / 2;
            background: #ffffff1a;
            border-width: 1px;
            border-color: Pal.glass-border;
            HorizontalLayout {
                padding-left: 18 * root.u;
                padding-right: 20 * root.u;
                spacing: 10 * root.u;
                alignment: center;
                Rectangle {
                    width: 9 * root.u;
                    height: 9 * root.u;
                    y: (parent.height - self.height) / 2;
                    border-radius: 5 * root.u;
                    background: root.consoles[root.idx].available ? #6bffa8 : #ffffff66;
                }
                Text {
                    text: root.consoles[root.idx].status;
                    font-size: 16 * root.u;
                    font-weight: 500;
                    color: Pal.text;
                    vertical-alignment: center;
                }
            }
        }
    }

    // page dots
    HorizontalLayout {
        y: root.height - 118 * root.u;
        height: 10 * root.u;
        alignment: center;
        spacing: 9 * root.u;
        for c[i] in root.consoles: Rectangle {
            width: (i == root.idx ? 30 : 9) * root.u;
            height: 9 * root.u;
            border-radius: 5 * root.u;
            background: i == root.idx ? #ffffff : #ffffff55;
            animate width { duration: 260ms; easing: ease-out; }
        }
    }

    // key hints
    HorizontalLayout {
        y: root.height - 76 * root.u;
        height: 36 * root.u;
        alignment: center;
        spacing: 44 * root.u;
        Hint { key: "←  →"; label: "Choose"; u: root.u; }
        Hint { key: "Enter"; label: "Power on"; u: root.u; }
        Hint { key: "Esc"; label: "Quit"; u: root.u; }
    }
}
