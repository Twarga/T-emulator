import { Lt } from "theme.slint";
import { Txt, Mono, Tile } from "widgets.slint";
import { ConsoleInfo, RecentCard } from "../types.slint";
import { Icons } from "../icons.slint";

// focus: 0..r-1 = recent tiles, r..r+3 = console tiles
export component Home inherits Rectangle {
    in property <[ConsoleInfo]> consoles;
    in property <[RecentCard]> recents;
    in property <int> sel;
    in property <length> u: 1px;
    callback pick(int);

    property <int> r: root.recents.length;
    property <length> pad: 48 * root.u;
    property <length> rch: 250 * root.u;   // recent tile height incl. caption

    // ── continue playing ──
    Mono {
        visible: root.r > 0;
        x: root.pad;
        y: 10 * root.u;
        text: "CONTINUE";
        font-size: 11 * root.u;
        letter-spacing: 2 * root.u;
        color: Lt.faint;
    }
    for g[i] in root.recents: Tile {
        x: root.pad + i * (138 * root.u);
        y: 32 * root.u;
        art: g.cover;
        has-art: g.has-cover;
        title: g.title;
        console: "PSP";
        sub: g.ago;
        tone: g.tone;
        letter: g.letter;
        sel: i == root.sel;
        cw: 104 * root.u;
        u: root.u;
        TouchArea { clicked => { root.pick(i); } }
    }

    // ── consoles ──
    Mono {
        x: root.pad;
        y: root.r > 0 ? 32 * root.u + root.rch + 12 * root.u : 12 * root.u;
        text: "CONSOLES";
        font-size: 11 * root.u;
        letter-spacing: 2 * root.u;
        color: Lt.faint;
    }
    for c[i] in root.consoles: Rectangle {
        property <length> cw: (root.width - 2 * root.pad - 3 * 24 * root.u) / 4;
        property <length> ch: root.height - self.y - 40 * root.u;
        x: root.pad + i * (cw + 24 * root.u);
        y: root.r > 0 ? 32 * root.u + root.rch + 36 * root.u : 36 * root.u;
        width: cw;
        height: ch;
        border-radius: Lt.r-lg;
        background: i + root.r == root.sel ? Lt.surface2 : Lt.surface;
        border-width: 2px;
        border-color: i + root.r == root.sel ? Lt.accent : #00000000;
        opacity: c.available ? 1 : 0.55;
        animate background, y, height { duration: 200ms; }
        TouchArea { clicked => { root.pick(i + root.r); } }

        Image {
            source: Icons.device(c.kind);
            width: cw - 64 * root.u;
            height: ch * 0.46;
            x: 32 * root.u;
            y: 24 * root.u;
            image-fit: contain;
            opacity: c.available ? 0.95 : 0.5;
        }
        Txt {
            x: 26 * root.u;
            y: ch - 108 * root.u;
            text: c.name;
            font-size: 30 * root.u;
            font-weight: 600;
            color: Lt.text;
        }
        Txt {
            x: 27 * root.u;
            y: ch - 70 * root.u;
            width: cw - 52 * root.u;
            text: c.full-name;
            font-size: 14 * root.u;
            color: Lt.dim;
            overflow: elide;
        }
        Mono {
            x: 27 * root.u;
            y: ch - 38 * root.u;
            text: c.status;
            font-size: 12 * root.u;
            color: c.available ? Lt.ok : Lt.faint;
        }
    }
}
