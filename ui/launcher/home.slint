import { Lt } from "theme.slint";
import { Txt, Mono, Cover, Btn } from "widgets.slint";
import { ConsoleInfo, RecentCard } from "../types.slint";
import { Icons } from "../icons.slint";

// focus: 0..r-1 = recent cards, r..r+3 = console tiles
export component Home inherits Rectangle {
    in property <[ConsoleInfo]> consoles;
    in property <[RecentCard]> recents;
    in property <int> sel;
    in property <length> u: 1px;
    callback pick(int);

    property <int> r: root.recents.length;
    property <length> pad: 48 * root.u;

    // ── continue playing ──
    Mono {
        visible: root.r > 0;
        x: root.pad;
        y: 10 * root.u;
        text: "CONTINUE";
        font-size: 11 * root.u;
        letter-spacing: 2 * root.u;
        color: Lt.faint;
    }
    for g[i] in root.recents: Rectangle {
        x: root.pad + i * (356 * root.u);
        y: 34 * root.u;
        width: 340 * root.u;
        height: 100 * root.u;
        border-radius: Lt.r-lg;
        background: i == root.sel ? Lt.surface2 : Lt.surface;
        border-width: 2px;
        border-color: i == root.sel ? Lt.accent : #00000000;
        animate background { duration: 160ms; }
        TouchArea { clicked => { root.pick(i); } }

        Cover {
            x: 10 * root.u;
            y: 10 * root.u;
            width: 142 * root.u;
            height: 80 * root.u;
            title: g.title;
            console: "PSP";
            tone: g.tone;
            u: root.u;
        }
        Txt {
            x: 164 * root.u;
            y: 18 * root.u;
            width: 164 * root.u;
            text: g.title;
            font-size: 15 * root.u;
            font-weight: 500;
            wrap: word-wrap;
            max-height: 44 * root.u;
            overflow: elide;
            vertical-alignment: top;
        }
        Mono {
            x: 164 * root.u;
            y: 66 * root.u;
            text: g.ago;
            font-size: 11 * root.u;
            color: Lt.faint;
        }
    }

    // ── consoles ──
    Mono {
        x: root.pad;
        y: root.r > 0 ? 158 * root.u : 12 * root.u;
        text: "CONSOLES";
        font-size: 11 * root.u;
        letter-spacing: 2 * root.u;
        color: Lt.faint;
    }
    for c[i] in root.consoles: Rectangle {
        property <length> cw: (root.width - 2 * root.pad - 3 * 24 * root.u) / 4;
        property <length> ch: root.r > 0 ? 264 * root.u : 348 * root.u;
        x: root.pad + i * (cw + 24 * root.u);
        y: root.r > 0 ? 182 * root.u : 36 * root.u;
        width: cw;
        height: ch;
        border-radius: Lt.r-lg;
        background: i + root.r == root.sel ? Lt.surface2 : Lt.surface;
        border-width: 2px;
        border-color: i + root.r == root.sel ? Lt.accent : #00000000;
        opacity: c.available ? 1 : 0.55;
        animate background, y, height { duration: 200ms; }
        TouchArea { clicked => { root.pick(i + root.r); } }

        Image {
            source: Icons.device(c.kind);
            colorize: Lt.text;
            width: cw - 80 * root.u;
            height: ch * 0.44;
            x: 40 * root.u;
            y: 30 * root.u;
            image-fit: contain;
            opacity: c.available ? 0.92 : 0.5;
        }
        Txt {
            x: 26 * root.u;
            y: ch - 108 * root.u;
            text: c.name;
            font-size: 30 * root.u;
            font-weight: 600;
            color: Lt.text;
        }
        Txt {
            x: 27 * root.u;
            y: ch - 70 * root.u;
            width: cw - 52 * root.u;
            text: c.full-name;
            font-size: 14 * root.u;
            color: Lt.dim;
            overflow: elide;
        }
        Mono {
            x: 27 * root.u;
            y: ch - 38 * root.u;
            text: c.status;
            font-size: 12 * root.u;
            color: c.available ? Lt.ok : Lt.faint;
        }
    }
}
