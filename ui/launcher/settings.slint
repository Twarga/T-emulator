import { Lt } from "theme.slint";
import { Txt, Mono } from "widgets.slint";
import { SetRow } from "../types.slint";

export component Settings inherits Rectangle {
    in property <[SetRow]> rows;
    in property <int> sel;
    in property <length> u: 1px;
    callback act(int);

    property <length> pad: 48 * root.u;
    property <length> row-h: 62 * root.u;

    Txt {
        x: root.pad;
        y: 14 * root.u;
        text: "Settings";
        font-size: 24 * root.u;
        font-weight: 600;
    }

    for s[i] in root.rows: Rectangle {
        x: root.pad;
        y: 56 * root.u + i * (root.row-h + 8 * root.u);
        width: parent.width - 2 * root.pad;
        height: root.row-h;
        border-radius: Lt.r-lg;
        background: i == root.sel ? Lt.surface2 : Lt.surface;
        border-width: 2px;
        border-color: i == root.sel ? Lt.accent : #00000000;
        TouchArea { clicked => { root.act(i); } }

        Txt {
            x: 22 * root.u;
            y: 10 * root.u;
            text: s.label;
            font-size: 16 * root.u;
            font-weight: 500;
        }
        Mono {
            x: 22 * root.u;
            y: 36 * root.u;
            width: parent.width - 380 * root.u;
            text: s.hint;
            font-size: 11 * root.u;
            color: Lt.faint;
            overflow: elide;
        }

        if s.kind == "toggle": Rectangle {
            x: parent.width - 78 * root.u;
            y: (parent.height - 28 * root.u) / 2;
            width: 52 * root.u;
            height: 28 * root.u;
            border-radius: 14 * root.u;
            background: s.on ? Lt.accent : Lt.line;
            animate background { duration: 160ms; }
            Rectangle {
                width: 22 * root.u;
                height: 22 * root.u;
                x: s.on ? parent.width - self.width - 3 * root.u : 3 * root.u;
                y: 3 * root.u;
                border-radius: 11 * root.u;
                background: #fffdf8;
                animate x { duration: 160ms; easing: ease-out; }
            }
        }
        if s.kind == "value": Mono {
            x: parent.width - 400 * root.u;
            width: 374 * root.u;
            text: s.value;
            font-size: 12 * root.u;
            horizontal-alignment: right;
            color: Lt.dim;
            overflow: elide;
        }
        if s.kind == "action": Txt {
            x: parent.width - 150 * root.u;
            width: 124 * root.u;
            text: "Run";
            font-size: 13 * root.u;
            font-weight: 600;
            horizontal-alignment: right;
            color: Lt.dim;
        }
        if s.kind == "info": Mono {
            x: parent.width - 150 * root.u;
            width: 124 * root.u;
            text: s.value;
            font-size: 12 * root.u;
            horizontal-alignment: right;
            color: Lt.faint;
        }
    }
}
