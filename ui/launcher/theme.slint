// Launcher identity: warm graphite, one ember accent, IBM Plex Sans.
// Console shells keep their own theme (PSP = white-on-color XMB) — the
// launcher stays neutral so each shell's colors belong to the shell alone.
export global Lt {
    out property <color> bg: #161411;
    out property <color> surface: #1e1a15;
    out property <color> surface2: #262019;
    out property <color> line: #3a3229;
    out property <color> text: #ede7dd;
    out property <color> dim: #a89e90;
    out property <color> faint: #6f675c;
    out property <color> accent: #ff5a2a;
    out property <color> ok: #7dc98f;
    out property <length> r-lg: 12px;
    out property <length> r-sm: 6px;
    // muted cover tones for typographic game tiles
    out property <[color]> tones: [#3a4a52, #4a3b52, #52503a, #54453a, #3a5244, #524a66];
}
