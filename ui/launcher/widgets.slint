import { Lt } from "theme.slint";

// ── text in the launcher voice ──
export component Txt inherits Text {
    font-family: "IBM Plex Sans";
    color: Lt.text;
    vertical-alignment: center;
}
export component Mono inherits Text {
    font-family: "IBM Plex Mono";
    color: Lt.dim;
    vertical-alignment: center;
}

// ── game tile: real box art at PSP cover ratio, typographic fallback ──
// One tile everywhere — library grid, continue strip, demos.
export component Tile inherits Rectangle {
    in property <image> art;
    in property <bool> has-art;
    in property <string> title;
    in property <string> console;
    in property <string> sub;
    in property <int> tone;
    in property <string> letter;
    in property <bool> sel;
    in property <length> u: 1px;
    in property <length> cw: 120 * u;   // cover width
    property <length> chh: cw / 0.581; // cover height (box-art ratio)
    width: cw + 16 * u;
    height: 8 * u + chh + 8 * u + (root.sub != "" ? 46 * u : 32 * u);
    border-radius: Lt.r-lg;
    background: root.sel ? Lt.surface2 : #00000000;
    animate background { duration: 160ms; }

    Rectangle {
        x: 8 * u;
        y: 8 * u;
        width: root.cw;
        height: root.chh;
        border-radius: Lt.r-sm;
        clip: true;
        border-width: root.sel ? 2px : 0px;
        border-color: Lt.accent;
        background: Lt.tones[Math.mod(Math.max(0, root.tone), Lt.tones.length)];

        if root.has-art: Image {
            width: parent.width;
            height: parent.height;
            source: root.art;
            image-fit: cover;
        }
        if !root.has-art: Rectangle {
            Txt {
                x: parent.width - self.width - 8 * u;
                y: parent.height - self.height - 4 * u;
                text: root.letter;
                font-size: 64 * u;
                font-weight: 600;
                color: #ffffff12;
            }
            Mono {
                x: 8 * u;
                y: 7 * u;
                text: root.console;
                font-size: 8 * u;
                letter-spacing: 1.6 * u;
                color: #ffffffb0;
            }
            Txt {
                x: 8 * u;
                y: 20 * u;
                width: parent.width - 16 * u;
                text: root.title;
                font-size: 12 * u;
                font-weight: 500;
                wrap: word-wrap;
                color: #fffdf8;
            }
        }
    }
    Txt {
        x: 9 * u;
        y: 8 * u + root.chh + 8 * u;
        width: root.cw - 2 * u;
        text: root.title;
        font-size: 11.5 * u;
        font-weight: root.sel ? 600 : 400;
        color: root.sel ? Lt.text : Lt.dim;
        wrap: word-wrap;
        max-height: 28 * u;
        overflow: elide;
    }
    if root.sub != "": Mono {
        x: 9 * u;
        y: parent.height - 14 * u;
        width: root.cw - 2 * u;
        text: root.sub;
        font-size: 9.5 * u;
        color: Lt.faint;
        overflow: elide;
    }
}

// ── key hint chip + row ──
export component KeyChip inherits Rectangle {
    in property <string> label;
    in property <length> u: 1px;
    height: 26 * u;
    width: Math.max(26 * u, (root.label.character-count * 8 + 16) * u);
    border-radius: 6 * u;
    background: Lt.surface2;
    border-width: 1px;
    border-color: Lt.line;
    Mono {
        width: parent.width;
        height: parent.height;
        text: root.label;
        font-size: 12 * u;
        color: Lt.text;
        horizontal-alignment: center;
    }
}

export component LHint inherits Rectangle {
    in property <string> key;
    in property <string> label;
    in property <length> u: 1px;
    width: root.chipw + 10 * u + root.lab;
    property <length> chipw: Math.max(26 * u, (root.key.character-count * 8 + 16) * u);
    property <length> lab: (root.label.character-count * 7.5 + 8) * u;
    KeyChip {
        x: 0;
        y: (parent.height - self.height) / 2;
        label: root.key;
        u: root.u;
    }
    Txt {
        x: root.chipw + 10 * u;
        width: root.lab;
        height: parent.height;
        text: root.label;
        font-size: 13 * u;
        color: Lt.faint;
        vertical-alignment: center;
        overflow: elide;
    }
}

// ── pill action button ──
export component Btn inherits Rectangle {
    in property <string> label;
    in property <bool> primary;
    in property <length> u: 1px;
    width: 118 * u;
    height: 34 * u;
    border-radius: 17 * u;
    background: root.primary ? Lt.accent : Lt.surface2;
    border-width: 1px;
    border-color: root.primary ? Lt.accent : Lt.line;
    Txt {
        text: root.label;
        font-size: 13 * u;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: root.primary ? #1a0f08 : Lt.dim;
    }
}
