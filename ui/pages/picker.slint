import { Tokens } from "../tokens.slint";
import { TileCard } from "../components/tilecard.slint";

export struct ConsoleEntry {
    title: string,
    subtitle: string,
    glyph: string,
    enabled: bool,
    accent: color,
}

export component Picker inherits Rectangle {
    in property <[ConsoleEntry]> consoles;
    callback power_on(int);
    in-out property <int> focused-idx: 0;

    background: @linear-gradient(180deg, #0a0a14 0%, #0e0e1c 60%, #101024 100%);

    fs := FocusScope {
        key-pressed(ev) => {
            if (ev.text == Key.RightArrow) {
                if (root.focused-idx < root.consoles.length - 1) { root.focused-idx += 1; } accept
            } else if (ev.text == Key.LeftArrow) {
                if (root.focused-idx > 0) { root.focused-idx -= 1; } accept
            } else if (ev.text == Key.Return) {
                if (root.consoles[root.focused-idx].enabled) { root.power_on(root.focused-idx); } accept
            } else { reject }
        }
    }

    // top brand bar
    Rectangle {
        height: 90px; width: 100%;
        background: @linear-gradient(90deg, transparent, Tokens.accent-xmb.with-alpha(0.08), transparent);
        Text {
            text: "T-EMULATOR"; color: Tokens.text;
            font-size: 26px; font-weight: 300; letter-spacing: 10px;
        }
        Text {
            text: "Pick a console"; color: Tokens.text-dim; font-size: 13px;
            y: 52px;
        }
    }

    // console cards — centered strip, focus enlarges + glows
    HorizontalLayout {
        alignment: center; spacing: 28px;
        for c[idx] in root.consoles: TileCard {
            title: c.title; subtitle: c.subtitle; glyph: c.glyph;
            enabled: c.enabled; accent: c.accent;
            focused: idx == root.focused-idx;
            activated => { if (c.enabled) { root.power_on(idx); } }
        }
    }

    // bottom hint bar
    Rectangle {
        y: parent.height - 64px; width: 100%; height: 40px;
        Text {
            text: "◄ ►   choose      Ⓐ / Enter   power on";
            color: Tokens.text-dim; font-size: 13px;
            horizontal-alignment: center;
        }
    }
}
