// T-Emulator design tokens — single source for palette, type, motion.
export global Tokens {
    // palette
    out property <color> bg: #0e0e14;
    out property <color> surface: #16161f;
    out property <color> surface2: #1e1e2a;
    out property <color> border: #2a2a38;
    out property <color> text: #e8e8f0;
    out property <color> text-dim: #8a8a9e;
    out property <color> accent: #6e6eff;        // manager accent
    out property <color> accent-xmb: #4ea8ff;    // sony blue
    out property <color> accent-gc: #6a4fff;
    out property <color> accent-360: #3ddc84;
    out property <color> danger: #ff5a5a;

    // geometry
    out property <length> radius: 10px;
    out property <length> card-w: 260px;
    out property <length> card-h: 160px;

    // type
    out property <length> font-body: 14px;
    out property <length> font-title: 24px;
    out property <length> font-hero: 32px;
    out property <length> font-clock: 15px;

    // motion
    out property <duration> t-fast: 180ms;
    out property <duration> t-med: 250ms;
    out property <duration> t-slow: 350ms;
}
