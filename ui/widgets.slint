import { Pal } from "tokens.slint";

export component KeyChip inherits Rectangle {
    in property <string> label;
    in property <length> u: 1px;
    height: 36 * u;
    min-width: 36 * u;
    border-radius: 10 * u;
    background: #ffffff1c;
    border-width: 1px;
    border-color: #ffffff44;
    HorizontalLayout {
        padding-left: 12 * u;
        padding-right: 12 * u;
        Text {
            text: root.label;
            font-size: 17 * u;
            font-weight: 500;
            color: Pal.text;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}

export component Hint inherits HorizontalLayout {
    in property <string> key;
    in property <string> label;
    in property <length> u: 1px;
    spacing: 10 * u;
    KeyChip { label: root.key; u: root.u; }
    Text {
        text: root.label;
        font-size: 18 * u;
        color: Pal.text-dim;
        vertical-alignment: center;
    }
}

export component Toast inherits Rectangle {
    in property <string> text;
    in property <float> progress: -1;
    in property <bool> shown: false;
    in property <length> u: 1px;
    width: 640 * u;
    height: root.progress >= 0 ? 92 * u : 64 * u;
    border-radius: 18 * u;
    background: #05070fcc;
    border-width: 1px;
    border-color: #ffffff30;
    opacity: root.shown ? 1 : 0;
    animate opacity { duration: 220ms; }

    Text {
        x: 0;
        y: root.progress >= 0 ? 16 * u : 0;
        width: parent.width;
        height: 32 * u;
        text: root.text;
        font-size: 20 * u;
        font-weight: 500;
        color: Pal.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if root.progress >= 0: Rectangle {
        x: 32 * u;
        y: 60 * u;
        width: parent.width - 64 * u;
        height: 6 * u;
        border-radius: 3 * u;
        background: #ffffff26;
        Rectangle {
            width: parent.width * Math.min(Math.max(root.progress, 0), 1);
            height: parent.height;
            border-radius: 3 * u;
            background: #ffffff;
        }
    }
    if root.progress < 0: Rectangle { }
}
