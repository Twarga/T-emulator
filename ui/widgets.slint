import { Pal } from "tokens.slint";

export component KeyChip inherits Rectangle {
    in property <string> label;
    in property <length> u: 1px;
    height: 34 * u;
    min-width: 34 * u;
    border-radius: 9 * u;
    background: #ffffff1a;
    border-width: 1px;
    border-color: #ffffff40;
    HorizontalLayout {
        padding-left: 11 * u;
        padding-right: 11 * u;
        Text {
            text: root.label;
            font-size: 16 * u;
            font-weight: 500;
            color: Pal.text;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}

export component Hint inherits HorizontalLayout {
    in property <string> key;
    in property <string> label;
    in property <length> u: 1px;
    spacing: 10 * u;
    KeyChip { label: root.key; u: root.u; }
    Text {
        text: root.label;
        font-size: 17 * u;
        color: Pal.text-dim;
        vertical-alignment: center;
    }
}

export component Toast inherits Rectangle {
    in property <string> text;
    in property <float> progress: -1;
    in property <bool> shown: false;
    in property <length> u: 1px;
    width: 600 * u;
    height: root.progress >= 0 ? 88 * u : 60 * u;
    border-radius: 16 * u;
    background: #060912d8;
    border-width: 1px;
    border-color: #ffffff30;
    opacity: root.shown ? 1 : 0;
    animate opacity { duration: 220ms; }

    Text {
        x: 0;
        y: root.progress >= 0 ? 14 * u : 0;
        width: parent.width;
        height: root.progress >= 0 ? 34 * u : parent.height;
        text: root.text;
        font-size: 19 * u;
        font-weight: 500;
        color: Pal.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Rectangle {
        visible: root.progress >= 0;
        x: 32 * u;
        y: 58 * u;
        width: parent.width - 64 * u;
        height: 6 * u;
        border-radius: 3 * u;
        background: #ffffff26;
        Rectangle {
            width: parent.width * Math.min(Math.max(root.progress, 0), 1);
            height: parent.height;
            border-radius: 3 * u;
            background: #ffffff;
            animate width { duration: 140ms; }
        }
    }
}
